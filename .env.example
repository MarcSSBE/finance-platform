# Finance Platform — environment variables
# Copy to `.env.local` (or `.env`) and fill in real values. Both are gitignored.
# In production these live in Heroku config vars. Leave any blank to keep that
# feature dormant — the app degrades gracefully.

# --- Claude (optional assist layer) ---
# Powers the AI FALLBACK only (scanned/reformatted PDFs, column auto-detect) and
# plain-language summaries. The deterministic path runs without it. Reuse the key
# from the be-image-video-gen Heroku app, or use a dedicated key.
ANTHROPIC_API_KEY=
# Extraction/assist model. Opus for harder reasoning.
ANTHROPIC_MODEL=claude-sonnet-5

# --- Google Drive (Project 2 filing) ---
# A DEDICATED service account, added as a *Content manager member* of the
# "Accounting" Shared Drive. No domain-wide delegation / impersonation needed —
# Shared Drive membership lets it upload directly. Values come from the SA's
# downloaded JSON key.
#
# client_email from the JSON key:
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# The "Accounting" folder id (from its Drive URL: /folders/<id>).
GOOGLE_ACCOUNTING_DRIVE_ID=
# Private key. RECOMMENDED: base64-encode the JSON's `private_key` value — one
# safe line no editor can mangle:  `base64 -w0 <<< "$PRIVATE_KEY"` (or in Node:
# Buffer.from(privateKey).toString("base64")). The app decodes it.
GOOGLE_PRIVATE_KEY_BASE64=
# ALTERNATIVE (if you prefer): the raw key on one line, \n-escaped, in quotes.
# The app uses BASE64 if set, else falls back to this.
#   GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEv...\n-----END PRIVATE KEY-----\n"
GOOGLE_PRIVATE_KEY=

# --- Slack (Project 2 notifications, optional / later) ---
SLACK_TOKEN=
SLACK_CHANNEL=
