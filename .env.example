# Finance Platform — environment variables
# Copy to `.env.local` (or `.env`) and fill in real values. Both are gitignored.
# In production these live in Heroku config vars. Leave any blank to keep that
# feature dormant — the app degrades gracefully.

# --- Claude (optional assist layer) ---
# Powers the AI FALLBACK only (scanned/reformatted PDFs, column auto-detect) and
# plain-language summaries. The deterministic path runs without it.
ANTHROPIC_API_KEY=
# Extraction/assist model. Opus for harder reasoning.
ANTHROPIC_MODEL=claude-sonnet-5

# --- Google Drive (Project 2 filing) ---
# A DEDICATED service account, added as a *Content manager member* of the
# "Accounting" Shared Drive. No domain-wide delegation / impersonation needed —
# Shared Drive membership lets it upload directly. Values come from the SA's
# downloaded JSON key.
#
# client_email from the JSON key:
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# The "Accounting" folder id (from its Drive URL: /folders/<id>).
GOOGLE_ACCOUNTING_DRIVE_ID=
# Private key. RECOMMENDED: base64-encode the JSON's `private_key` value — one
# safe line no editor can mangle:  `base64 -w0 <<< "$PRIVATE_KEY"` (or in Node:
# Buffer.from(privateKey).toString("base64")). The app decodes it.
GOOGLE_PRIVATE_KEY_BASE64=
# ALTERNATIVE (if you prefer): the raw key on one line, \n-escaped, in quotes.
# The app uses BASE64 if set, else falls back to this.
#   GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEv...\n-----END PRIVATE KEY-----\n"
GOOGLE_PRIVATE_KEY=

# --- Slack (Project 2 notifications, optional / later) ---
SLACK_TOKEN=
SLACK_CHANNEL=

# --- Amazon seller-fee invoices (Project 3) ---
# The MVP (semi-automatic: Veronica uploads the Seller Central "Tax Document
# Library" ZIP, the portal renames + files it) needs NO NEW KEYS. It reuses the
# Google Drive + Slack config above. Everything below is for OPTIONAL later phases
# and the app stays fully functional while these are blank.
#
# Phase 2 — cross-check the filed invoices against Amazon's reported fee totals
# via the Selling Partner API (LWA credentials). There is NO SP-API endpoint that
# returns the fee-invoice PDFs (confirmed), so SP-API is only ever used here for
# reconciliation numbers, never for the download. One credential set per SP-API
# region (a default set + an EU set for the European marketplaces).
AMZ_CLIENT_ID=
AMZ_CLIENT_SECRET=
AMZ_REFRESH_TOKEN=
AMZ_CLIENT_ID_EU=
AMZ_CLIENT_SECRET_EU=
AMZ_REFRESH_TOKEN_EU=
# SP-API host for the EU region (Burman's European marketplaces). Default shown.
AMZ_SPAPI_ENDPOINT_EU=https://sellingpartnerapi-eu.amazon.com
# Optional: comma-separated marketplace IDs to pull, e.g.
# DE=A1PA6795UKMFR9, FR=A13V1IB3VIYZZH, BE=AMEN7PMS3EDWL, SE=A2NODRKZP88ZB9.
# Leave blank to use the account's default marketplaces.
AMZ_MARKETPLACE_IDS_EU=
#
# Phase 2b — fully automated download by driving Seller Central in a headless
# browser (fragile / ToS gray area; only if the upload step is not enough).
# Needs a login plus a TOTP secret so it can generate the 2FA code itself.
AMZ_SELLER_EMAIL=
AMZ_SELLER_PASSWORD=
AMZ_TOTP_SECRET=
